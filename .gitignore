# t8n corpus: the path itself is a symlink to the FISCO-BCOS/op-stack-e2e-tests
# checkout (CI provisions it via tools/.ci/provision_t8n_corpus.sh; tracking a
# machine-absolute symlink broke CI checkouts — see finding F-CI-2). The patterns
# below are leftovers from the earlier in-tree vendored subset; git cannot
# re-include files under an ignored parent, so the ! entries are inert by design.
opstack-executor/tests/t8n
bcos-evm/test/opstack/t8n/cases/
opstack-executor/tests/t8n/cases/
opstack-executor/tests/t8n/vectors/*.json
!opstack-executor/tests/t8n/vectors/isthmus_deposit_only.json
!opstack-executor/tests/t8n/vectors/jovian_deposit_only.json
!opstack-executor/tests/t8n/vectors/jovian_transfer_multi.json
opstack-executor/tests/t8n/golden/engine/*.golden.json
!opstack-executor/tests/t8n/golden/engine/isthmus_deposit_only.golden.json
!opstack-executor/tests/t8n/golden/engine/jovian_deposit_only.golden.json
!opstack-executor/tests/t8n/golden/engine/jovian_transfer_multi.golden.json
opstack-executor/tests/t8n/golden/engine/chained/*.json

test/*
/CMakeSettings.json

# Claude Code
CLAUDE.local.md
.worktrees/

# Review intermediate artifacts — never commit into a product branch.
.agents/reviews/
.claude/worktrees
.claude/agents

# RocksDB unittest working directory (created by UT runs, never commit).
unittestdb/

# Process/planning documents stay local-only (archived under ~/octo/docs-archive).
docs/plans/
