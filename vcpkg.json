{
  "name": "fiscobcos",
  "version-string": "3.16.1",
  "homepage": "https://github.com/FISCO-BCOS/FISCO-BCOS",
  "description": "FISCO BCOS",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "magic-enum",
    "boost-log",
    "boost-beast",
    "boost-uuid",
    "boost-heap",
    "boost-graph",
    "boost-context",
    "boost-property-map",
    "boost-chrono",
    "boost-iostreams",
    "boost-thread",
    "boost-test",
    "boost-compute",
    "boost-container-hash",
    "boost-multiprecision",
    "boost-program-options",
    "boost-stacktrace",
    "ms-gsl",
    "protobuf",
    "fakeit",
    "tbb",
    "jsoncpp",
    {
      "name": "jwt-cpp",
      "features": [
        "picojson"
      ]
    },
    "evmc",
    "curl",
    "tomlplusplus",
    {
      "name": "openssl",
      "version>=": "1.1.1-tassl"
    },
    "fmt",
    "secp256k1",
    {
      "name": "aws-sdk-cpp",
      "features": [
        "kms"
      ]
    },
    "wedprcrypto",
    "range-v3",
    "rapidhash",
    "proxy",
    "hsm-crypto",
    {
      "name": "tarscpp",
      "version>=": "3.0.3-3"
    }
  ],
  "features": {
    "fullnode": {
      "description": "Full node dependencies",
      "dependencies": [
        "evmone",
        "boost-coroutine2",
        {
          "name": "rocksdb",
          "features": [
            "zstd",
            "tbb"
          ]
        },
        "zstd",
        "cryptopp",
        "tarscpp",
        "blst",
        "ittapi",
        "gmp",
        "group-sig",
        "paillier"
      ]
    },
    "lightnode": {
      "description": "Light node dependencies",
      "dependencies": [
        {
          "name": "rocksdb",
          "features": [
            "zstd",
            "tbb"
          ]
        },
        "zstd",
        "tarscpp"
      ]
    },
    "tests": {
      "description": "for test dependencies",
      "dependencies": [
        "indicators",
        "benchmark",
        "zlib",
        "tarscpp",
        "hsm-crypto",
        "ethereum-tests"
      ]
    },
    "tcmalloc": {
      "description": "tcmalloc dependencies",
      "dependencies": [
        {
          "name": "gperftools",
          "features": [
            "override"
          ]
        }
      ]
    },
    "mimalloc": {
      "description": "mimalloc dependencies",
      "dependencies": [
        "mimalloc"
      ]
    }
  },
  "builtin-baseline": "62159a45e18f3a9ac0548628dcaf74fcb60c6ff9",
  "overrides": [
    {
      "name": "boost-context",
      "version": "1.90.0-u1"
    },
    {
      "name": "curl",
      "$comment": "curl 8.18+ requires OpenSSL >= 3.0, which conflicts with the Tassl 1.1.1 ports/openssl overlay; 8.17.0 is the last version supporting OpenSSL 1.1.1. Unpin when OpenSSL 3 lands, see https://github.com/FISCO-BCOS/FISCO-BCOS/issues/5601",
      "version": "8.17.0"
    }
  ]
}
