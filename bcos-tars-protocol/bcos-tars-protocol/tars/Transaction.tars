module bcostars {
    /// EIP-2930 access list entry (derived from Web3 RLP at submission; optional on chain).
    struct Web3AccessListEntry
    {
        0 optional string account;              // 40-char hex address, no 0x prefix
        1 optional vector<vector<byte>> storageKeys;  // each key is 32 bytes (h256)
    };

    /// EIP-7702 authorization tuple (derived from Web3 RLP at submission).
    struct Web3AuthorizationListEntry
    {
        0 optional string chainId;        // decimal string, 0 = any chain
        1 optional string address;        // 40-char hex, no 0x prefix
        2 optional string nonce;          // decimal string
        3 optional byte   yParity;        // 0 or 1
        4 optional vector<byte> r;        // 32 bytes
        5 optional vector<byte> s;        // 32 bytes
    };

    struct TransactionData {
        1  optional int          version;
        2  optional string       chainID;
        3  optional string       groupID;
        4  optional long         blockLimit;
        5  optional string       nonce;
        6  optional string       to;
        7  optional vector<byte> input;
        8  optional string       abi;
        9  optional string       value;
        10 optional string       gasPrice;
        11 optional long         gasLimit;
        12 optional string       maxFeePerGas;
        13 optional string       maxPriorityFeePerGas;
        14 optional vector<byte> extension;
        15 optional vector<Web3AccessListEntry> accessList;
        16 optional vector<Web3AuthorizationListEntry> authorizationList;
    };

    struct Transaction
    {
        1  optional TransactionData data;
        2  optional vector<byte>    dataHash;             // type == 0, hash(data); type == 1, hash(extraTransactionBytes); hash for sign
        3  optional vector<byte>    signature;
        4  optional long            importTime;
        5  optional int             attribute;
                                                          // 6 optional string source;
        7  optional vector<byte>    sender;
        8  optional string          extraData;
        9  optional byte            type;
        10 optional vector<byte>    extraTransactionBytes;
        11 optional vector<byte>    extraTransactionHash; // hash(rlp(10|3)); real transaction hash
        /// bcos::rpc::TransactionType (0=Legacy, 1=EIP2930, 2=EIP1559, 3=EIP4844); only when type==1 (Web3)
        12 optional byte            web3TypedTxKind;
    };
};
