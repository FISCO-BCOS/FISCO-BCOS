module bcostars {
    struct LogEntry {
        1 optional string address;
        2 optional vector<vector<byte>> topic;
        3 optional vector<byte> data;
    };

    struct TransactionReceiptData {
        1 require  int              version;
        2 optional string           gasUsed;
        3 optional string           contractAddress;
        4 optional int              status;
        5 optional vector<byte>     output;
        6 optional vector<LogEntry> logEntries;
        7 optional long             blockNumber;
        8 optional string           effectiveGasPrice;
    };

    // OP Stack (Isthmus/Jovian) receipt metadata, serialized by the OP execution layer.
    // All 13 fields are hex strings (0 values stored as "0x0") so explicit zero presence
    // survives tars serialization (tars optional scalar has no presence semantics).
    struct OpStackReceiptMeta {
        0 optional string l1_gas_price;          // uint256 hex
        1 optional string l1_fee;                // uint256 hex
        2 optional string l1_blob_base_fee;      // uint256 hex
        3 optional string l1_base_fee_scalar;    // hex(值 0 存 "0x0")
        4 optional string l1_blob_base_fee_scalar;
        5 optional string operator_fee_scalar;
        6 optional string operator_fee_constant;
        7 optional string da_footprint_gas_scalar;
        8 optional string da_footprint;
        9 optional string deposit_nonce;
        10 optional string deposit_receipt_version;
        11 optional string l1_gas_used;
        12 optional string operator_fee;          // uint256 hex(FISCO 扩展)
    };

    struct TransactionReceipt {
        1 optional TransactionReceiptData data;
        2 optional vector<byte>           dataHash;
        3 optional string                 message;

        4 optional string                 cumulativeGasUsed;
        5 optional vector<byte>           logsBloom;
        6 optional unsigned int           transactionIndex;
        7 optional unsigned int           logIndex;

        // 2026-08-05: field 8 replaced `string opReceiptMeta` (RLP) with this struct.
        // Optional so receipts that NEVER wrote field 8 (pre-OP legacy) decode to nullopt.
        // ⚠️ NOT backward-compatible with persisted string@tag8 OP receipts: decoding one
        // throws TarsDecodeException (tars type mismatch) — accepted because dev stage has no
        // persisted OP receipts; wire migration needed if old-format data ever appears.
        8 optional OpStackReceiptMeta      opStackMeta;
    };
};